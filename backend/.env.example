SECRET_KEY=change-this-dev-secret-to-32-bytes-min
JWT_SECRET_KEY=change-this-jwt-secret-to-32-bytes-min

MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=velora_shop

# Leave 0 for MySQL. Set 1 only if you need a local SQLite fallback.
USE_SQLITE=0

FRONTEND_ORIGIN=http://localhost:5173
